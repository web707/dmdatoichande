{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanoi Guide Public Destinations",
    "version": "1.0.0",
    "description": "Versioned public reads backed by the same places catalog as the legacy API."
  },
  "paths": {
    "/api/v1/destinations": {
      "get": {
        "operationId": "listDestinations",
        "summary": "List public destination summaries",
        "description": "Results are ordered by creation time, then destination ID. Each page reflects the current catalog.",
        "security": [],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pass the previous page's nextCursor unchanged, using the same search term.",
            "schema": { "type": "string", "minLength": 64, "maxLength": 64 }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Literal substring of the Vietnamese name, English name, or address. Case and accents are ignored, and whitespace is trimmed and collapsed.",
            "schema": { "type": "string", "maxLength": 100, "pattern": "^[^\\u0000]*$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Destination page, including an empty items list when there are no matches.",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "example": "public, no-cache" } },
              "ETag": { "schema": { "type": "string" } }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DestinationPage" } } }
          },
          "304": { "description": "The page is unchanged for the supplied If-None-Match header." },
          "400": {
            "description": "Invalid query parameters.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          },
          "403": {
            "description": "Origin is not allowed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          },
          "429": {
            "description": "Request limit exceeded.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          },
          "503": {
            "description": "Catalog service is unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          }
        }
      }
    },
    "/api/v1/destinations/{id}": {
      "get": {
        "operationId": "getDestination",
        "summary": "Read the travel details for one destination",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Destination details.",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "example": "public, no-cache" } },
              "ETag": { "schema": { "type": "string" } }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DestinationDetail" } } }
          },
          "304": { "description": "The destination is unchanged for the supplied If-None-Match header." },
          "400": {
            "description": "Malformed destination ID.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          },
          "403": {
            "description": "Origin is not allowed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          },
          "404": {
            "description": "The destination does not exist.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          },
          "429": {
            "description": "Request limit exceeded.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          },
          "503": {
            "description": "Catalog service is unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DestinationSummary": {
        "type": "object",
        "required": ["id", "nameVi", "nameEn", "summaryEn", "imageUrl", "imageCredit", "address"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nameVi": { "type": "string" },
          "nameEn": { "type": "string" },
          "summaryEn": { "type": "string" },
          "imageUrl": { "type": "string" },
          "imageCredit": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "DestinationPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": { "$ref": "#/components/schemas/DestinationSummary" }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Opaque continuation cursor, or null at the end of the list."
          }
        }
      },
      "DestinationDetail": {
        "type": "object",
        "required": [
          "id", "nameVi", "nameEn", "summaryEn", "imageUrl", "imageCredit", "address",
          "historyEn", "cultureEn", "latitude", "longitude", "sourceUrl", "openingHours",
          "ticketPriceVnd", "ticketPriceUsd", "bookingInfo", "visitDurationMin", "bestTimeToVisit"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nameVi": { "type": "string" },
          "nameEn": { "type": "string" },
          "summaryEn": { "type": "string" },
          "imageUrl": { "type": "string" },
          "imageCredit": { "type": "string" },
          "address": { "type": "string" },
          "historyEn": { "type": "string" },
          "cultureEn": { "type": "string" },
          "latitude": { "type": "number", "format": "double", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "format": "double", "minimum": -180, "maximum": 180 },
          "sourceUrl": { "type": "string", "description": "An empty string when the source is absent." },
          "openingHours": { "type": "string" },
          "ticketPriceVnd": { "type": "integer", "format": "int32" },
          "ticketPriceUsd": { "type": "string", "description": "Exact PostgreSQL decimal as text." },
          "bookingInfo": { "type": "string" },
          "visitDurationMin": { "type": "integer", "format": "int32" },
          "bestTimeToVisit": { "type": "string" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  }
}
